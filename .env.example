# The only two keys you need. Add both in Vercel -> Settings -> Environment Variables.

# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional ---

# Lock the bot to one Telegram chat (e.g. Meera's) so nobody else can use it.
ALLOWED_CHAT_ID=

# Defaults to gemini-2.5-flash.
GEMINI_MODEL=
