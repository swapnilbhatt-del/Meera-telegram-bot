# From @BotFather in Telegram
TELEGRAM_BOT_TOKEN=

# Any long random string. Telegram sends it back on every request so we can
# reject calls that don't come from Telegram. Generate one with:
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Meera's Telegram chat ID. Only this chat gets drafts; everyone else is ignored.
# Leave blank at first, message the bot, and it will reply with your chat ID.
ALLOWED_CHAT_ID=

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Only used by `npm run set-webhook` (your deployed URL, no trailing slash)
PUBLIC_URL=https://your-project.vercel.app
